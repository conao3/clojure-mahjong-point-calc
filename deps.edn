{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/tools.logging {:mvn/version "1.3.1"}
  com.stuartsierra/component {:mvn/version "1.2.0"}
  org.slf4j/slf4j-simple {:mvn/version "2.0.20"}
  http-kit/http-kit {:mvn/version "2.8.1"}
  com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}
  com.lambdaisland/config {:mvn/version "0.15.56"}
  metosin/malli {:mvn/version "0.20.3"}}

 :aliases
 {:dev {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                     com.stuartsierra/component.repl {:mvn/version "1.0.0"}}
        :extra-paths ["dev" "test"]}
  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                      cider/cider-nrepl {:mvn/version "0.63.1"}}
         :jvm-opts ["-Djdk.attach.allowAttachSelf"]
         :main-opts ["-m" "nrepl.cmdline"
                     "--interactive"
                     "--middleware" "[cider.nrepl/cider-middleware]"]}
  :test {:main-opts ["-e" "(require 'dev)"
                     "-m" "kaocha.runner"]}
  :build {:extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
